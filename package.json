{
  "name": "sudsnik",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "packages/kernel",
    "packages/contracts",
    "packages/infra/*",
    "packages/clients",
    "packages/external",
    "packages/services/*",
    "apps/*",
    "tools/lint"
  ],
  "scripts": {
    "start": "node --import tsx apps/cli/src/main.ts start",
    "release": "node --import tsx apps/release/src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -b"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/utils": "^8.70.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "fastify-type-provider-zod": "^7.0.0",
    "@fastify/swagger": "^9.8.1",
    "ulidx": "^2.4.1",
    "zod": "^4.6.5",
    "yaml": "^2.9.1"
  }
}
