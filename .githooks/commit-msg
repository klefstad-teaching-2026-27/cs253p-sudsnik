#!/usr/bin/env bash
# commit-msg hook: enforce Conventional Commits and reject attribution trailers.
msg_file="$1"
subject="$(grep -v "^#" "$msg_file" | sed -n "1p")"

# Allow merge/revert/fixup commits generated by git itself.
case "$subject" in
  Merge\ *|Revert\ \"*|fixup!\ *|squash!\ *) exit 0 ;;
esac

types="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
pattern="^(${types})(\([a-z0-9._/-]+\))?!?: [^ ].{0,71}$"

if ! printf "%s" "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<EOM
commit rejected: subject must follow Conventional Commits

  <type>(<optional scope>): <imperative summary, max 72 chars>

  types: feat fix docs style refactor perf test build ci chore revert
  e.g.   feat(runner): add stdio runner with normalized comparator
         chore: add commit-msg hook

  got:   "$subject"
EOM
  exit 1
fi

if grep -Eiq "^[[:space:]]*(Co-Authored-By|Claude-Session|Signed-off-by)" "$msg_file" \
   || grep -Eiq "^[^[:alnum:]]*(generated|created) with" "$msg_file" \
   || grep -Eiq "claude\.ai/code/session|claude\.com/claude-code" "$msg_file"; then
  echo "commit rejected: attribution trailers are not allowed in this repository" >&2
  exit 1
fi
